# Railway automatically adds DATABASE_URL when PostgreSQL plugin is connected
DATABASE_URL=postgresql://postgres:password@localhost:5432/erp_supply

# Or separately (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=erp_supply

# App
PORT=3001
NODE_ENV=development
JWT_SECRET=change_me_in_production

# Auth: set to 'true' to disable authentication (dev/test only)
# AUTH_DISABLED=true

